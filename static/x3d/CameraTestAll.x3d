<Script DEF="Arrival_TestSubjectA" directOutput="true" mustEvaluate="true">
  <field name="waypointOrder"   type="SFInt32" accessType="initializeOnly" value="1"/>
  <field name="startFromLoader" type="SFTime"  accessType="inputOnly"/>
  <field name="arrived"         type="SFBool"  accessType="inputOnly"/>
  <field name="releaseDwell"    type="SFBool"  accessType="inputOnly"/>
  <field name="advanceSeg"      type="SFInt32" accessType="inputOnly"/>
  <field name="resetSeg"        type="SFBool"  accessType="inputOnly"/>
  <field name="segmentArrived"  type="SFInt32" accessType="outputOnly"/>
  <![CDATA[ecmascript:
  var _seg=0;
  var _wasActive=false;
  var _timerIds=['Timer_TestSubjectA_1','Timer_TestSubjectA_2','Timer_TestSubjectA_3','Timer_TestSubjectA_4','Timer_TestSubjectA_5','Timer_TestSubjectA_6','Timer_TestSubjectA_7','Timer_TestSubjectA_8','Timer_TestSubjectA_9','Timer_TestSubjectA_10','Timer_TestSubjectA_11','Timer_TestSubjectA_12','Timer_TestSubjectA_13','Timer_TestSubjectA_14','Timer_TestSubjectA_15','Timer_TestSubjectA_16','Timer_TestSubjectA_17','Timer_TestSubjectA_18','Timer_TestSubjectA_19','Timer_TestSubjectA_20','Timer_TestSubjectA_21'];
  var _dwellIds=['Dwell_TestSubjectA_1','Dwell_TestSubjectA_2','Dwell_TestSubjectA_3','Dwell_TestSubjectA_4','Dwell_TestSubjectA_5','Dwell_TestSubjectA_6','Dwell_TestSubjectA_7','Dwell_TestSubjectA_8','Dwell_TestSubjectA_9','Dwell_TestSubjectA_10','Dwell_TestSubjectA_11','Dwell_TestSubjectA_12','Dwell_TestSubjectA_13','Dwell_TestSubjectA_14','Dwell_TestSubjectA_15','Dwell_TestSubjectA_16','Dwell_TestSubjectA_17','Dwell_TestSubjectA_18','Dwell_TestSubjectA_19','Dwell_TestSubjectA_20','Dwell_TestSubjectA_21'];
  var _maxSeg=21;
  function initialize(){ Browser.println("Arrival_TestSubjectA: ready maxSeg="+_maxSeg+" order=1"); }
  function resetSeg(val,time){ if(!val)return; _seg=0; _wasActive=false; }
  function startFromLoader(val,time){
    if(val<=0)return;
    try{ var t=Browser.currentScene.getNamedNode(_timerIds[0]);
      if(t){t.startTime=time+0.1;t.enabled=true;Browser.println("Arrival_TestSubjectA: Timer_1 fired at "+(time+0.1));}
    }catch(e){Browser.println("Arrival_TestSubjectA startFromLoader err: "+e);}
  }
  function arrived(val,time){
    if(val){ _wasActive=true; return; }
    if(!_wasActive) return;
    _wasActive=false; _seg++; segmentArrived=_seg;
    Browser.println("Arrival_TestSubjectA: arrived seg "+_seg);
  }
  function advanceSeg(completedSeg,time){
    var nextIdx=completedSeg;
    if(nextIdx>=_maxSeg){ Browser.println("Arrival_TestSubjectA: arc complete"); return; }
    var tNow=(time&&time>0)?time:Browser.currentTime;
    try{ var t=Browser.currentScene.getNamedNode(_timerIds[nextIdx]);
      if(t){t.startTime=tNow;t.enabled=true;Browser.println("Arrival_TestSubjectA: Timer_"+(nextIdx+1)+" at "+tNow);}
    }catch(e){Browser.println("Arrival_TestSubjectA advanceSeg err: "+e);}
  }
  function releaseDwell(val,time){
    if(!val||_seg<1)return;
    if(_seg>_dwellIds.length)return;
    var dwId=_dwellIds[_seg-1];
    try{
      var dw=Browser.currentScene.getNamedNode(dwId);
      dw.enabled=true;
      dw.startTime=Browser.currentTime;
      Browser.println("Arrival_TestSubjectA: released dwell "+dwId);
    }catch(e){Browser.println("Arrival_TestSubjectA releaseDwell error: "+e);}
  }
  ]]>
</Script>

<Script DEF="Kill_TestSubjectA" directOutput="true" mustEvaluate="true">
  <field name="killAll" type="SFBool" accessType="inputOnly"/>
  <field name="resetPos" type="SFBool" accessType="inputOnly"/>
  <![CDATA[ecmascript:
  var timerIds=['Timer_TestSubjectA_1','Dwell_TestSubjectA_1','Timer_TestSubjectA_2','Dwell_TestSubjectA_2','Timer_TestSubjectA_3','Dwell_TestSubjectA_3','Timer_TestSubjectA_4','Dwell_TestSubjectA_4','Timer_TestSubjectA_5','Dwell_TestSubjectA_5','Timer_TestSubjectA_6','Dwell_TestSubjectA_6','Timer_TestSubjectA_7','Dwell_TestSubjectA_7','Timer_TestSubjectA_8','Dwell_TestSubjectA_8','Timer_TestSubjectA_9','Dwell_TestSubjectA_9','Timer_TestSubjectA_10','Dwell_TestSubjectA_10','Timer_TestSubjectA_11','Dwell_TestSubjectA_11','Timer_TestSubjectA_12','Dwell_TestSubjectA_12','Timer_TestSubjectA_13','Dwell_TestSubjectA_13','Timer_TestSubjectA_14','Dwell_TestSubjectA_14','Timer_TestSubjectA_15','Dwell_TestSubjectA_15','Timer_TestSubjectA_16','Dwell_TestSubjectA_16','Timer_TestSubjectA_17','Dwell_TestSubjectA_17','Timer_TestSubjectA_18','Dwell_TestSubjectA_18','Timer_TestSubjectA_19','Dwell_TestSubjectA_19','Timer_TestSubjectA_20','Dwell_TestSubjectA_20','Timer_TestSubjectA_21','Dwell_TestSubjectA_21'];
  var startX=0, startY=0, startZ=0;
  function killAll(val,time){
    if(!val)return;
    for(var i=0;i<timerIds.length;i++){
      try{Browser.currentScene.getNamedNode(timerIds[i]).enabled=false;}catch(e){}
    }
  }
  function resetPos(val,time){
    if(!val)return;
    killAll(true,time);
    try{
      var av=Browser.currentScene.getNamedNode("Avatar_TestSubjectA");
      av.translation=new SFVec3f(startX,startY,startZ);
    }catch(e){Browser.println("Kill_TestSubjectA resetPos error: "+e);}
    try{
      Browser.currentScene.getNamedNode("Arrival_TestSubjectA").resetSeg=true;
    }catch(e){}
  }
  ]]>
</Script>
<Script DEF="MCCFMaster" directOutput="true" mustEvaluate="true">
<field accessType="initializeOnly" type="SFString" name="api_url" value="http://localhost:5000"/>
<field accessType="inputOnly" type="SFString" name="startAgent"/>
<field accessType="inputOnly" type="SFString" name="releaseDwellAgent"/>
<field accessType="inputOnly" type="SFString" name="startNextTimer"/>
<field accessType="inputOnly" type="SFVec3f" name="pos_TestSubjectA"/>
<field accessType="outputOnly" type="SFFloat" name="arousal_TestSubjectA"/>
<field accessType="inputOnly" type="SFVec3f" name="pos_TestSubjectB"/>
<field accessType="outputOnly" type="SFFloat" name="arousal_TestSubjectB"/>
<![CDATA[ecmascript:
var _sceneNow=0;
function _getSceneNow(agent,seg){var t=Browser.currentScene.getNamedNode("Timer_"+agent+"_"+seg);if(t&&t.time!==undefined&&t.time>0)return t.time;if(t&&t.startTime!==undefined&&t.cycleTime!==undefined&&(t.startTime+t.cycleTime)>0)return t.startTime+t.cycleTime;return _sceneNow;}
function initialize(){Browser.println("MCCFMaster initialized.");}
function startNextTimer(agentColonSeg,time){
  try{
  var parts=agentColonSeg.split(":");
  var nextSeg=parseInt(parts[1])+1;
  var t=Browser.currentScene.getNamedNode("Timer_"+parts[0]+"_"+nextSeg);
  if(t){t.startTime=time;t.enabled=true;Browser.println("MCCFMaster: started Timer_"+parts[0]+"_"+nextSeg+" (next) at "+time);}
  else{Browser.println("MCCFMaster: no Timer_"+parts[0]+"_"+nextSeg+" — arc complete");}
}catch(e){Browser.println("MCCFMaster: startNextTimer end of arc — "+e.message);}
}
function startAgent(agentSafeName,time){
  var t=Browser.currentScene.getNamedNode("Timer_"+agentSafeName+"_1");
  if(t){t.startTime=time;t.enabled=true;_sceneNow=time;Browser.println("MCCFMaster: started Timer_"+agentSafeName+"_1 at "+time);}
  else{Browser.println("MCCFMaster: Timer_"+agentSafeName+"_1 NOT FOUND");}
}
function releaseDwellAgent(agentColonSeg,time){
  var parts=agentColonSeg.split(":");
  var dw=Browser.currentScene.getNamedNode("Dwell_"+parts[0]+"_"+parts[1]);
  if(dw){var tNow=_getSceneNow(parts[0],parseInt(parts[1]));dw.startTime=tNow;dw.enabled=true;Browser.println("MCCFMaster: started Dwell_"+parts[0]+"_"+parts[1]+" at "+tNow);}
  else{Browser.println("MCCFMaster: Dwell_"+parts[0]+"_"+parts[1]+" NOT FOUND");}
}
]]>
</Script>
