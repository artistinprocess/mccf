      <AudioDestination DEF='SoundNode_Giparu_Ambient'>
        <Gain DEF='GainNode_Giparu_Ambient'
            gain='0'>
          <AudioClip DEF='Clip_Giparu_Ambient' containerField='children'
              loop='true'
              startTime='-1'
              stopTime='-2'/>
        </Gain>
      </AudioDestination>
      <Script DEF='SoundFader_Giparu'
          directOutput='true'
          mustEvaluate='true'>
        <field accessType='inputOnly' type='SFBool' name='isActive'/>
        <field accessType='inputOnly' type='SFBool' name='playing'/>
        <field accessType='inputOnly' type='SFFloat' name='masterVolume'/>
<![CDATA[ecmascript:
  var _fadeTimer=null; var _targetGain=0; var _curGain=0;
  var _playing=false; var _masterVol=1.0;
  var FADE_MS=300; var STEPS=15;
  function _setGainNode(v){
    try{
      var g=Browser.currentScene.getNamedNode("GainNode_Giparu_Ambient");
      if(g) g.getField("gain").setValue(v);
    }catch(e){}
  }
  function _ramp(from,to){
    if(_fadeTimer){clearInterval(_fadeTimer);_fadeTimer=null;}
    var ceiling=Math.min(to, _masterVol);
    _curGain=from; _targetGain=ceiling;
    var step=(ceiling-from)/STEPS; var interval=Math.round(FADE_MS/STEPS);
    _fadeTimer=setInterval(function(){
      _curGain+=step;
      var done=(step>0?_curGain>=_targetGain:_curGain<=_targetGain);
      if(done){_curGain=_targetGain;clearInterval(_fadeTimer);_fadeTimer=null;}
      _setGainNode(_curGain);
    },interval);
  }
  function masterVolume(val, time) {
    _masterVol = val;
    if (_curGain > 0) { _setGainNode(Math.min(_curGain, _masterVol)); }
  }
  function playing(val, time) {
    _playing = val;
    Browser.println("SoundFader_Giparu: playing=" + val);
    if (!val) {
      _ramp(_curGain, 0);
      try { var clip = Browser.currentScene.getNamedNode("Clip_Giparu_Ambient"); if (clip) clip.getField("stopTime").setValue(Browser.currentTime + (FADE_MS/1000)); } catch(e) {}
    }
  }
  function isActive(val, time) {
    if (!_playing) { Browser.println("SoundFader_Giparu: GATED isActive="+val); return; }
    var clip = Browser.currentScene.getNamedNode("Clip_Giparu_Ambient");
    if (val) {
      if (clip && clip.url && clip.url.length>0 && clip.url[0]) {
        try{clip.getField("stopTime").setValue(-2);clip.getField("startTime").setValue(Browser.currentTime);}catch(e){}
        _ramp(0, 0.80);
      }
      Browser.println("SoundFader_Giparu: ENTER");
    } else {
      _ramp(_curGain, 0);
      try{if(clip)clip.getField("stopTime").setValue(Browser.currentTime+(FADE_MS/1000));}catch(e){}
      Browser.println("SoundFader_Giparu: EXIT");
    }
  }
  ]]>
      </Script>
