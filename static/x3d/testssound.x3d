<ROUTE fromNode="CAM_TrackOriInterp_The_Steward" fromField="value_changed" toNode="CAM_TrackXform_The_Steward" toField="set_rotation"/>
</Transform>
<!-- Agent: The Witness -->
<Transform DEF="Avatar_The_Witness" translation="20.56666666666667 0 16.75555555555556">
  <!-- MCCF entanglement sensor — size tunable per zone type via coupler layer -->
  <ProximitySensor DEF="Prox_The_Witness" size="2 2.2 2" enabled="true"/>
  <Inline DEF="HAnim_The_Witness" url='&quot;../avatars/mixamo1.x3d&quot;'/>
  <IMPORT inlineDEF="HAnim_The_Witness" exportedDEF="DefaultTimer" AS="DefaultTimer_The_Witness"/>
  <IMPORT inlineDEF="HAnim_The_Witness" exportedDEF="PitchTimer" AS="PitchTimer_The_Witness"/>
  <IMPORT inlineDEF="HAnim_The_Witness" exportedDEF="YawTimer" AS="YawTimer_The_Witness"/>
  <IMPORT inlineDEF="HAnim_The_Witness" exportedDEF="RollTimer" AS="RollTimer_The_Witness"/>
  <IMPORT inlineDEF="HAnim_The_Witness" exportedDEF="WalkTimer" AS="WalkTimer_The_Witness"/>
  <IMPORT inlineDEF="HAnim_The_Witness" exportedDEF="RunTimer" AS="RunTimer_The_Witness"/>
  <IMPORT inlineDEF="HAnim_The_Witness" exportedDEF="JumpTimer" AS="JumpTimer_The_Witness"/>
  <IMPORT inlineDEF="HAnim_The_Witness" exportedDEF="KickTimer" AS="KickTimer_The_Witness"/>
<Transform translation="0 3.1 0"><Billboard axisOfRotation="0 1 0"><Shape><Appearance><Material emissiveColor="0.8 0.95 1.0"/></Appearance>
<Text DEF="NameText_The_Witness" string='"The Witness"' ><FontStyle size="0.32" family='"SANS"' justify='"MIDDLE"'/></Text></Shape></Billboard></Transform>
<Viewpoint DEF="VP_The_Witness_Eye" description="The Witness Eye" position="0 1.7 0.2" orientation="0 1 0 3.14159" jump="true"/>
<Viewpoint DEF="VP_The_Witness_Side" description="The Witness Side" position="2.5 1.5 0" orientation="0 1 0 1.5708" jump="true"/>
<Transform DEF="CAM_OrbitXform_The_Witness" translation="0 3.2 8.6" rotation="0 1 0 0">
  <Viewpoint DEF="VP_The_Witness_Orbit" description="The Witness Orbit" position="0 0 0" orientation="0 1 0 0.0001" jump="true"/>
</Transform>
<TimeSensor DEF="CAM_OrbitTimer_The_Witness" cycleInterval="4" loop="false" enabled="false"/>
<PositionInterpolator DEF="CAM_OrbitPosInterp_The_Witness" key="0" keyValue="0 3.2 8.6"/>
<OrientationInterpolator DEF="CAM_OrbitOriInterp_The_Witness" key="0" keyValue="0 1 0 0.0001"/>
<ROUTE fromNode="CAM_OrbitTimer_The_Witness" fromField="fraction_changed" toNode="CAM_OrbitPosInterp_The_Witness" toField="set_fraction"/>
<ROUTE fromNode="CAM_OrbitTimer_The_Witness" fromField="fraction_changed" toNode="CAM_OrbitOriInterp_The_Witness" toField="set_fraction"/>
<ROUTE fromNode="CAM_OrbitPosInterp_The_Witness" fromField="value_changed" toNode="CAM_OrbitXform_The_Witness" toField="set_translation"/>
<ROUTE fromNode="CAM_OrbitOriInterp_The_Witness" fromField="value_changed" toNode="CAM_OrbitXform_The_Witness" toField="set_rotation"/>
<Transform DEF="CAM_TrackXform_The_Witness" translation="-3 1.7 4" rotation="0 1 0 0">
  <Viewpoint DEF="VP_The_Witness_Track" description="The Witness Track" position="0 0 0" orientation="0 1 0 0.0001" jump="true"/>
</Transform>
<TimeSensor DEF="CAM_TrackTimer_The_Witness" cycleInterval="4" loop="false" enabled="false"/>
<PositionInterpolator DEF="CAM_TrackPosInterp_The_Witness" key="0" keyValue="-3 1.7 4"/>
<OrientationInterpolator DEF="CAM_TrackOriInterp_The_Witness" key="0" keyValue="0 1 0 0.0001"/>
<ROUTE fromNode="CAM_TrackTimer_The_Witness" fromField="fraction_changed" toNode="CAM_TrackPosInterp_The_Witness" toField="set_fraction"/>
<ROUTE fromNode="CAM_TrackTimer_The_Witness" fromField="fraction_changed" toNode="CAM_TrackOriInterp_The_Witness" toField="set_fraction"/>
