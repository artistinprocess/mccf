</Transform>
<TimeSensor DEF="CAM_TrackTimer_The_Steward" cycleInterval="4" loop="false" enabled="false"/>
<PositionInterpolator DEF="CAM_TrackPosInterp_The_Steward" key="0" keyValue="-3 1.7 4"/>
<OrientationInterpolator DEF="CAM_TrackOriInterp_The_Steward" key="0" keyValue="0 1 0 0.0001"/>
<ROUTE fromNode="CAM_TrackTimer_The_Steward" fromField="fraction_changed" toNode="CAM_TrackPosInterp_The_Steward" toField="set_fraction"/>
<ROUTE fromNode="CAM_TrackTimer_The_Steward" fromField="fraction_changed" toNode="CAM_TrackOriInterp_The_Steward" toField="set_fraction"/>
