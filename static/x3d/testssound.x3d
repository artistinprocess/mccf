<!-- Zone: WP2 -->
<Transform DEF="Zone_soundtestzonw" translation="18.8 0 19.1">
<Shape><Appearance><Material diffuseColor="0.290 0.941 0.659" transparency="0.55" emissiveColor="0.290 0.941 0.659"/></Appearance><Cylinder height="0.5" radius="4"/></Shape>
<Transform translation="0 3.2 0"><Billboard axisOfRotation="0 1 0"><Shape><Appearance><Material emissiveColor="0.290 0.941 0.659"/></Appearance>
<Text string='"WP2"' ><FontStyle size="0.28" family='"SANS"' justify='"MIDDLE"'/></Text></Shape></Billboard></Transform>
<ProximitySensor DEF="Prox_soundtestzonw" size="8 4 8" enabled="true"/>
<AudioDestination DEF="SoundNode_soundtestzonw_Ambient" gain="1.0">
  <Gain DEF="GainNode_soundtestzonw_Ambient" containerField="children" gain="0">
    <AudioClip DEF="Clip_soundtestzonw_Ambient" containerField="children" url='"media/stinger1horn.mp3"'  loop="false" gain="1.0" startTime="-1" stopTime="-2"/>
  </Gain>
</AudioDestination>
<Script DEF="SoundFader_soundtestzonw" directOutput="true" mustEvaluate="true">
  <field name="isActive"     type="SFBool"  accessType="inputOnly"/>
  <field name="playing"      type="SFBool"  accessType="inputOnly"/>
  <field name="masterVolume" type="SFFloat" accessType="inputOnly"/>
  <![CDATA[ecmascript:
  var _fadeTimer=null; var _targetGain=0; var _curGain=0;
  var _playing=false; var _masterVol=1.0;
  var FADE_MS=300; var STEPS=15;
  function _setGainNode(v){
    try{
      var g=Browser.currentScene.getNamedNode("GainNode_soundtestzonw_Ambient");
      if(g) g.getField("gain").setValue(v);
    }catch(e){}
  }
  function _ramp(from,to){
    if(_fadeTimer){clearInterval(_fadeTimer);_fadeTimer=null;}
    var ceiling=Math.min(to, _masterVol);
    _curGain=from; _targetGain=ceiling;
    var step=(ceiling-from)/STEPS; var interval=Math.round(FADE_MS/STEPS);
    _fadeTimer=setInterval(function(){
      _curGain+=step;
      var done=(step>0?_curGain>=_targetGain:_curGain<=_targetGain);
      if(done){_curGain=_targetGain;clearInterval(_fadeTimer);_fadeTimer=null;}
      _setGainNode(_curGain);
    },interval);
  }
  function masterVolume(val, time) {
    _masterVol = val;
    if (_curGain > 0) { _setGainNode(Math.min(_curGain, _masterVol)); }
  }
  function playing(val, time) {
    _playing = val;
    Browser.println("SoundFader_soundtestzonw: playing=" + val);
    if (!val) {
      _ramp(_curGain, 0);
      try { var clip = Browser.currentScene.getNamedNode("Clip_soundtestzonw_Ambient"); if (clip) clip.getField("stopTime").setValue(Browser.currentTime + (FADE_MS/1000)); } catch(e) {}
    }
  }
  function isActive(val, time) {
    if (!_playing) { Browser.println("SoundFader_soundtestzonw: GATED isActive="+val); return; }
    var clip = Browser.currentScene.getNamedNode("Clip_soundtestzonw_Ambient");
    if (val) {
      if (clip && clip.url && clip.url.length>0 && clip.url[0]) {
        try{clip.getField("stopTime").setValue(-2);clip.getField("startTime").setValue(Browser.currentTime);}catch(e){}
        _ramp(0, 0.80);
      }
      Browser.println("SoundFader_soundtestzonw: ENTER");
    } else {
      _ramp(_curGain, 0);
      try{if(clip)clip.getField("stopTime").setValue(Browser.currentTime+(FADE_MS/1000));}catch(e){}
      Browser.println("SoundFader_soundtestzonw: EXIT");
    }
  }
  ]]>
</Script>
<!-- Track 4: Dwell one-shot — fired by loader SAI on dwell expiry -->
<AudioDestination DEF="SoundNode_soundtestzonw_Dwell" gain="0.98">
  <AudioClip DEF="Clip_soundtestzonw_Dwell" containerField="children" url='"media/soundeffects/Thunder1.mp3"' loop="false" gain="1.0" startTime="-1" stopTime="-2"/>
